# === Variables à créer dans Vercel (Settings > Environment Variables). Jamais dans GitHub. ===
# Neon PostgreSQL : chaîne de connexion complète
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Clé de signature des sessions : 32 caractères aléatoires minimum
SESSION_SECRET=
# Premier super administrateur (créé automatiquement au premier appel)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optionnel (traduction multimédia V14)
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_API_TOKEN=

# === Traduction de fichiers volumineux (V16) ===
# Cloudflare R2 (bucket privé) — Vercel ET worker
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Taille maximale acceptée par fichier, en Go (défaut 50)
MAX_UPLOAD_GB=50
# Adresse du worker Cloud Run et jeton partagé (Vercel : pour le réveiller ; worker : pour l'authentifier)
WORKER_URL=
WORKER_TOKEN=
# Worker uniquement : bucket Google Cloud Storage temporaire pour la transcription audio/vidéo
GCS_BUCKET=
